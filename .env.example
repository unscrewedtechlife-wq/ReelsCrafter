# ─── Application ──────────────────────────────────────────────────────────────
ENVIRONMENT=development
SECRET_KEY=super_secret_jwt_key_change_me_in_production_min_32_chars
FRONTEND_URL=http://localhost:3000

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=viewmax
POSTGRES_PASSWORD=viewmax_secret
POSTGRES_DB=viewmax
DATABASE_URL=postgresql+asyncpg://viewmax:viewmax_secret@localhost:5432/viewmax

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=redis_secret
REDIS_URL=redis://:redis_secret@localhost:6379/0

# ─── MinIO / S3 Storage ───────────────────────────────────────────────────────
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin_secret
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin_secret
S3_REGION=us-east-1

# ─── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_YOUR_KEY_HERE
STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_KEY_HERE
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET_HERE

# Stripe Price IDs (create in Stripe dashboard)
STRIPE_PRICE_CREATOR=price_creator_monthly
STRIPE_PRICE_PRO=price_pro_monthly
STRIPE_PRICE_AGENCY=price_agency_monthly

# ─── AI Providers (swap mock → real by adding keys) ───────────────────────────
# Video
RUNWAY_API_KEY=
LUMA_API_KEY=
KLING_API_KEY=
PIKA_API_KEY=
GOOGLE_VEO_API_KEY=

# Image
OPENAI_API_KEY=
REPLICATE_API_KEY=
IDEOGRAM_API_KEY=

# Voice
ELEVENLABS_API_KEY=
PLAYHT_API_KEY=
AZURE_SPEECH_KEY=

# ─── Self-Hosted Local AI Engines ─────────────────────────────────────────────
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL_DIRECTOR=llama3
OLLAMA_MODEL_SCRIPT=qwen3
OLLAMA_MODEL_REASONING=deepseek-r1
COMFYUI_URL=http://localhost:8188
PIPER_TTS_URL=http://localhost:5000

# ─── Hardware & FFmpeg Performance Flags ──────────────────────────────────────
USE_NVENC=true
FFMPEG_PRESET=fast
STORYBOARD_RESOLUTION=512
DRAFT_RESOLUTION_P=480
FINAL_RESOLUTION_P=1080

# ─── Frontend ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_KEY_HERE
